<simulation verbosity='low'>
  <output prefix='simulation'>
    <properties stride='200' filename='out'>  [ step, time{picosecond}, conserved{electronvolt}, temperature{kelvin}, kinetic_cv{electronvolt}, potential{electronvolt}, pressure_cv{megapascal}, pressure_md{megapascal}, density{g/cm3} ] </properties>
    <trajectory filename='pos' stride='200' format='xyz' cell_units='angstrom'> positions{angstrom} </trajectory>
    <trajectory filename='force' stride='200' format='xyz' cell_units='angstrom'> forces{atomic_unit} </trajectory>
    <properties stride='200' filename='total_energy'>  [ time{picosecond}, conserved{electronvolt}] </properties>
    <properties stride='200' filename='stress'>  [ time{picosecond}, virial_md{megapascal}] </properties>
    <checkpoint stride='200' filename='checkpoint'>39733</checkpoint>
  </output>
  <total_steps>2000000</total_steps>
  <prng>
    <seed>92782</seed>
  </prng>
  <ffsocket mode='unix' name='driver'>
    <address>localhost</address>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='xyz' units='angstrom'> config.xyz </file>
      <cell mode='abc' units='angstrom'>
        [25.5739,25.5739,25.5739]
      </cell>
      <velocities mode='thermal' units='kelvin'>365</velocities>
    </initialize>
    <forces>
      <force forcefield='driver'/>
    </forces>
    <ensemble>
      <temperature units='kelvin'>365</temperature>
    </ensemble>
    <motion mode='dynamics'>
      <fixcom> False </fixcom>
      <dynamics mode='nvt'>
        <thermostat mode='langevin'>
          <tau units='femtosecond'>100</tau>
        </thermostat>
        <timestep units='femtosecond'>0.500</timestep>
      </dynamics>
    </motion>
  </system>
</simulation>
