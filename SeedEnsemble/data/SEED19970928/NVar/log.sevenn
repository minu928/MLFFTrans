act_gate            : {'e': 'silu', 'o': 'tanh'}
weight_nn_hidden_neurons: [64, 64]
conv_denominator    : avg_num_neigh
train_denominator   : False
train_shift_scale   : False
use_bias_in_linear  : False
use_modal_node_embedding: False
use_modal_self_inter_intro: False
use_modal_self_inter_outro: False
use_modal_output_block: False
readout_as_fcn      : False
readout_fcn_hidden_neurons: [30, 30]
readout_fcn_activation: relu
self_connection_type: nequip
interaction_type    : nequip
_normalize_sph      : True
use_flash_tp        : True
cuequivariance_config: {'use': True}

from train configuration
device              : cuda
random_seed         : 19970928
epoch               : 1000
loss                : mse
loss_param          : {}
optimizer           : adam
optim_param         : {'lr': 0.005}
scheduler           : exponentiallr
scheduler_param     : {'gamma': 0.99}
force_loss_weight   : 0.1
stress_loss_weight  : 1e-06
per_epoch           : 100
continue            : {'checkpoint': False, 'reset_optimizer': False, 'reset_scheduler': False, 'reset_epoch': False, \
                       'use_statistic_values_of_checkpoint': True, 'use_statistic_values_for_cp_modal_only': True}
csv_log             : log.csv
num_workers         : 0
is_train_stress     : True
train_shuffle       : True
error_record        : [['Energy', 'RMSE'], ['Force', 'RMSE'], ['Stress', 'RMSE'], ['TotalLoss', 'None']]
best_metric         : TotalLoss
use_weight          : False
use_modality        : False
is_ddp              : False
ddp_backend         : nccl
local_rank          : 0
rank                : 0
world_size          : 1

from data configuration
