csv_log             : log.csv
num_workers         : 0
is_train_stress     : True
train_shuffle       : True
error_record        : [['Energy', 'RMSE'], ['Force', 'RMSE'], ['Stress', 'RMSE'], ['TotalLoss', 'None']]
best_metric         : TotalLoss
use_weight          : False
use_modality        : False
is_ddp              : False
ddp_backend         : nccl
local_rank          : 0
rank                : 0
world_size          : 1

from data configuration
